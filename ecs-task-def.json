{
  "family": "menu-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "3072",
  "executionRoleArn": "arn:aws:iam::363934055577:role/service-role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "menu-container",
      "image": "363934055577.dkr.ecr.eu-central-1.amazonaws.com/menu-service:latest",
      "essential": true,
      "portMappings": [
        { "containerPort": 3000, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "PORT", "value": "3000" }
      ]
    }
  ]
}
